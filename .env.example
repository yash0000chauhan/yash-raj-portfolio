# Public site URL used for canonical, sitemap, robots, and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:4327

# Optional override for the public email shown in the contact panel.
# Defaults to the address in src/content/site.ts when empty.
NEXT_PUBLIC_CONTACT_EMAIL=

# Server-only destination for the contact API. Falls back to NEXT_PUBLIC_CONTACT_EMAIL.
CONTACT_EMAIL=

# Optional Resend delivery. Without this key the API returns a mailto URL.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
